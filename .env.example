# ============================================================
# Synthetic Exposure — Environment Variables
# Copy to web/.env.local (frontend) and api/.env (backend).
# Never commit .env or .env.local with real secrets.
# ============================================================

# ─── Frontend / Vercel ─────────────────────────────────────

# Base URL for public endpoints fetched directly by the browser
# (asset lists, public chart data) — no trailing slash
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only Vercel variable — FastAPI origin used by Next.js route
# handlers / Server Components for authenticated or entitlement-specific
# requests (BFF pattern). NOT NEXT_PUBLIC_ — never exposed to the browser.
# Must be the backend's public HTTPS origin (Vercel cannot reach a Render
# private/internal URL).
BACKEND_API_URL=http://localhost:8000

# Server-only Vercel variable — must exactly match the backend's
# BFF_SHARED_SECRET. Lets the backend's rate limiter trust the real
# end-user IP the BFF forwards (X-Forwarded-Client-IP) instead of Vercel's
# own shared egress IP, which every BFF-proxied request would otherwise
# show. Optional: rate limiting still works without it, just bucketed by
# Vercel's IP rather than each user's own.
BFF_SHARED_SECRET=

# Reown AppKit project ID — from cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Robinhood Chain ID for wallet prompts (display/wallet-switch only — the
# backend's SYNTHEX_CHAIN_ID is the authoritative value for access decisions)
NEXT_PUBLIC_SYNTHEX_CHAIN_ID=

# Public RPC URL used only for wallet-facing reads / "add this chain"
# prompts. Separate from and never the same value as the private
# ROBINHOOD_RPC_URL below, which never reaches the frontend. Leave empty
# until a public Robinhood Chain RPC endpoint is available.
NEXT_PUBLIC_SYNTHEX_RPC_URL=

# ERC-20 contract address for the $SynthEx token (display only)
# Do NOT invent this value — must be confirmed by the owner
NEXT_PUBLIC_SYNTHEX_TOKEN_ADDRESS=

# Canonical public URL of this site (used in wallet connection metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Approved third-party DEX URL for buying $SynthEx
# Do NOT invent this value — must be confirmed by the owner
NEXT_PUBLIC_SYNTHEX_BUY_URL=

# ─── Backend (api/) ────────────────────────────────────────

APP_ENV=development

# PostgreSQL connection string (Render PostgreSQL in production).
# Defaults to SQLite (sqlite+aiosqlite:///./dev.db) when unset.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synthetic_exposure

# HMAC pepper for stored session-token hashes (generate a random 64-char
# string). Required to be strong (32+ chars, not the placeholder default)
# outside development/test — the app refuses to start otherwise.
SESSION_SECRET=change-me-to-a-random-64-char-string

# Comma-separated allowed CORS origins (browser → API access, NOT the SIWE
# identity policy — see SIWE_ALLOWED_DOMAINS/URIS below)
CORS_ORIGINS=http://localhost:3000

# SIWE identity policy — which domain/URI values a signed-in message may
# assert. Left unset, both default to CORS_ORIGINS for developer
# convenience; set explicitly in production to decouple the two.
SIWE_ALLOWED_DOMAINS=
SIWE_ALLOWED_URIS=

# Marketstack / CoinGecko API keys — required when USE_DEMO_DATA=false
MARKETSTACK_API_KEY=
COINGECKO_API_KEY=
# "demo" (free, x-cg-demo-api-key header) or "pro" (paid, x-cg-pro-api-key)
COINGECKO_API_TYPE=demo

# ── $SynthEx / Robinhood Chain — all fail closed until fully set ──

SYNTHEX_CHAIN_ID=
SYNTHEX_TOKEN_ADDRESS=
SYNTHEX_TOKEN_DECIMALS=18
# Raw token balance threshold for holder access (no decimal point)
SYNTHEX_HOLDER_MIN_BALANCE_RAW=

# Server-only RPC for Robinhood Chain reads — never exposed to the frontend
ROBINHOOD_RPC_URL=

# $SynthEx/ETH purchase verification
SYNTHEX_DEX_ROUTER_ADDRESSES=
SYNTHEX_DEX_POOL_ADDRESSES=
SYNTHEX_WETH_ADDRESS=
SYNTHEX_MIN_CONFIRMATIONS=12
SYNTHEX_TOKEN_START_BLOCK=0
ETH_USD_MAX_PRICE_AGE_MINUTES=60

# Portfolio — chains enabled for wallet position reads beyond Robinhood
# Chain (comma-separated chain IDs); Ethereum/Base stay disabled until
# their RPC URLs are supplied
PORTFOLIO_CHAIN_IDS=
ETHEREUM_RPC_URL=
BASE_RPC_URL=

# Multicall3 is deployed at the same well-known address on Ethereum/Base by
# default (see api/app/services/multicall.py) — only set this to add/override
# a chain, e.g. Robinhood Chain once its Multicall3 deployment (if any) is
# confirmed. Comma-separated "chain_id:address" pairs, e.g. "4663:0x...".
MULTICALL3_ADDRESS_OVERRIDES=

# Secret header value for Cloudflare cron job authentication
CRON_SECRET=change-me

# Must exactly match the frontend's BFF_SHARED_SECRET (see .env.example
# above) — see services/rate_limit.py for what this enables. Optional.
BFF_SHARED_SECRET=

# Set to true to use deterministic fixture data instead of live providers.
# With USE_DEMO_DATA=false, both MARKETSTACK_API_KEY and COINGECKO_API_KEY are required.
USE_DEMO_DATA=true
