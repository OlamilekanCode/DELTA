# ============================================================
# Synthetic Exposure — Environment Variables
# Copy to web/.env.local (frontend) and api/.env (backend).
# Never commit .env or .env.local with real secrets.
# ============================================================

# ─── Frontend / Vercel ─────────────────────────────────────

# Base URL for the FastAPI backend — used by the browser for public endpoints
# (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only Vercel variable — FastAPI origin used by Next.js route handlers
# (BFF pattern). NOT NEXT_PUBLIC_ — never exposed to the browser.
# Local: http://localhost:8000
# Production: your Render service's public HTTPS origin
BACKEND_API_URL=http://localhost:8000

# Reown AppKit project ID — from cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Chain ID for the $SynthEx token
# Must match SYNTHEX_CHAIN_ID in api/.env
NEXT_PUBLIC_SYNTHEX_CHAIN_ID=

# ERC-20 contract address for the $SynthEx token
# Do NOT invent this value — must be confirmed by the owner
NEXT_PUBLIC_SYNTHEX_TOKEN_ADDRESS=

# Minimum $SynthEx balance required to unlock holder access.
# Must be in raw token base units (no decimal point).
# Example: 1 token with 18 decimals = "1000000000000000000"
# Omit or leave empty to disable the balance gate in development.
NEXT_PUBLIC_SYNTHEX_HOLDER_MIN_BALANCE=

# Canonical public URL of this site (used in wallet connection metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Approved third-party DEX URL for buying $SynthEx
# Do NOT invent this value — must be confirmed by the owner
NEXT_PUBLIC_SYNTHEX_BUY_URL=

# ─── Backend (api/) ────────────────────────────────────────

APP_ENV=development

# PostgreSQL connection string.
# Defaults to SQLite (sqlite+aiosqlite:///./dev.db) when unset.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synthetic_exposure

# Secret used to sign session cookies (generate a random 64-char string)
SESSION_SECRET=change-me-to-a-random-64-char-string

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Marketstack API key — required when USE_DEMO_DATA=false
MARKETSTACK_API_KEY=

# CoinGecko API key — required when USE_DEMO_DATA=false
COINGECKO_API_KEY=

# CoinGecko API plan: "demo" (free, x-cg-demo-api-key header)
#                 or "pro"  (paid, x-cg-pro-api-key header)
COINGECKO_API_TYPE=demo

# $SynthEx token on-chain config (used for backend holder verification)
# Chain ID for Robinhood Chain — must be set explicitly, no default
SYNTHEX_CHAIN_ID=
SYNTHEX_TOKEN_ADDRESS=
# Token decimals (default 18 if unset)
SYNTHEX_TOKEN_DECIMALS=18
# Raw token balance threshold for holder access (no decimal point)
SYNTHEX_HOLDER_MIN_BALANCE_RAW=

# RPC URL for Robinhood Chain — required for on-chain balance reads
ROBINHOOD_RPC_URL=

# Secret header value for Cloudflare cron job authentication
CRON_SECRET=change-me

# Set to true to use deterministic fixture data instead of live providers.
# With USE_DEMO_DATA=false, both MARKETSTACK_API_KEY and COINGECKO_API_KEY are required.
USE_DEMO_DATA=true
