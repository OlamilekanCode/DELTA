# ============================================================
# DELTA Environment Variables
# Copy to web/.env.local (frontend) and api/.env (backend).
# Never commit .env or .env.local with real secrets.
# ============================================================

# ─── Frontend (web/) ───────────────────────────────────────

# Base URL for the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Reown AppKit project ID — from cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Chain ID for the $DELTA token (8453 = Base mainnet)
NEXT_PUBLIC_CHAIN_ID=8453

# ERC-20 contract address for the $DELTA token
# Do NOT invent this value — confirmed by the owner before enabling wallet gating
NEXT_PUBLIC_DELTA_TOKEN_ADDRESS=

# Minimum $DELTA balance required to unlock portfolio access.
# Must be in raw token base units (no decimal point).
# Example: 1 token with 18 decimals = "1000000000000000000"
# Omit or leave empty to disable the balance gate in development.
NEXT_PUBLIC_DELTA_MIN_BALANCE=

# Canonical public URL of this site (used in wallet connection metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Approved third-party DEX URL for buying $DELTA
# Do NOT invent this value — confirmed by the owner before enabling wallet gating
NEXT_PUBLIC_DEX_BUY_URL=

# ─── Backend (api/) ────────────────────────────────────────

APP_ENV=development

# PostgreSQL connection string
# Defaults to SQLite (sqlite+aiosqlite:///./dev.db) when unset
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/delta

# Secret used to sign session cookies
SESSION_SECRET=change-me-to-a-random-64-char-string

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Marketstack API key — required when USE_DEMO_DATA=false
MARKETSTACK_API_KEY=

# CoinGecko API key — required when USE_DEMO_DATA=false
COINGECKO_API_KEY=

# CoinGecko API plan type: "demo" (free) or "pro" (paid)
# Demo plan: x-cg-demo-api-key header, up to 10,000 credits/month
# Pro plan:  x-cg-pro-api-key header
COINGECKO_API_TYPE=demo

# Alchemy API key — for on-chain $DELTA balance reads
ALCHEMY_API_KEY=

# On-chain config for $DELTA token gating
DELTA_CHAIN_ID=8453
DELTA_TOKEN_ADDRESS=
DELTA_MIN_BALANCE=

# Secret header value for the Railway cron refresh job
CRON_SECRET=change-me

# Set to true to use deterministic fixture data.
# With USE_DEMO_DATA=false, both MARKETSTACK_API_KEY and COINGECKO_API_KEY are required.
USE_DEMO_DATA=true
