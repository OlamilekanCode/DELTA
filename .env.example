# ============================================================
# DELTA Environment Variables — copy to .env.local (frontend)
# and .env (backend), then fill in real values.
# NEVER commit .env or .env.local with real secrets.
# ============================================================

# ─── Frontend (web/) ───────────────────────────────────────
# Base URL for the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Reown AppKit project ID — from cloud.reown.com
# Added in Milestone 4
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Chain ID for the $DELTA token (8453 = Base mainnet)
NEXT_PUBLIC_CHAIN_ID=8453

# ERC-20 contract address for $DELTA token
# Do NOT invent this value — confirmed by the owner before Milestone 4
NEXT_PUBLIC_DELTA_TOKEN_ADDRESS=

# Minimum $DELTA balance required to unlock portfolio access.
# Value MUST be in raw token base units — no decimal point.
# Example: 1 token with 18 decimals = "1000000000000000000"
# Omit or leave empty to disable the balance gate in development.
NEXT_PUBLIC_DELTA_MIN_BALANCE=

# Canonical public URL of this site (used in wallet connection metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Approved third-party DEX URL for buying $DELTA
# Do NOT invent this value — confirmed by the owner before Milestone 4
NEXT_PUBLIC_DEX_BUY_URL=

# ─── Backend (api/) ────────────────────────────────────────
APP_ENV=development

# PostgreSQL connection string (added in Milestone 2)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/delta

# Secret used to sign session cookies
SESSION_SECRET=change-me-to-a-random-64-char-string

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Marketstack API key (added in Milestone 2)
MARKETSTACK_API_KEY=

# CoinGecko API key (added in Milestone 2)
COINGECKO_API_KEY=

# Alchemy or other RPC provider key for on-chain balance reads (Milestone 4)
ALCHEMY_API_KEY=

# On-chain config for $DELTA token gating (confirmed by owner)
DELTA_CHAIN_ID=8453
DELTA_TOKEN_ADDRESS=
DELTA_MIN_BALANCE=

# Secret header value for the Railway Cron refresh job
CRON_SECRET=change-me

# Set to true to use fixture data; automatically true when keys are absent
USE_DEMO_DATA=true
